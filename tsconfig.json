{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "src",
    "tests"
  ]
}
