OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_VOICE=coral
# /talk text turns and reports share OPENAI_MODEL / OPENAI_BASE_URL. No temperature is sent.
OPENAI_TOOL_MODE=plan-execute
OWM_API_KEY=
# Deployment maps these aliases to BRAVE_SEARCH_API_KEY / NCP_API_KEY_ID / NCP_API_KEY.
# NCP uses NAVER API HUB search (web documents, news and blogs).
BRAVE-SEARCH-API-KEY=
X-NCP-APIGW-API-KEY-ID=
X-NCP-APIGW-API-KEY=
LOG_LEVEL=info
DISCORD_WEBHOOK_URL=
